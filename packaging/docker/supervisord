[supervisord]
nodaemon=true
user=root

[program:fts-qos]
command=/usr/sbin/fts_qos -n -t 25
autostart=true
autorestart=false
priority=50
stdout_logfile =/var/log/fts3/fts_qos.log
redirect_stderr=true

[program:fts-server]
command=/usr/sbin/fts_server -n -t 25
autostart=true
autorestart=false
priority=50
stdout_logfile =/var/log/fts3/fts_server.log
redirect_stderr=true

[program:fts-token]
command=/usr/sbin/fts_token -n -t 25
autostart=true
autorestart=false
priority=50
stdout_logfile =/var/log/fts3/fts_token.log
redirect_stderr=true

[program:fts-optimizer]
command=/usr/sbin/fts_optimizer -n -t 25
autostart=true
autorestart=false
priority=50
stdout_logfile =/var/log/fts3/fts_optimizer.log
redirect_stderr=true

[program:fts-activemq]
command=/usr/sbin/fts_activemq -n
autostart=true
autorestart=false
priority=50
stdout_logfile =/var/log/fts3/fts_activemq.log
redirect_stderr=true

[program:cron]
command=/usr/sbin/crond -n
autostart=true
autorestart=false
priority=50
stdout_logfile =/var/log/fts3/cron.log
redirect_stderr=true
